{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/715224/qiuzhi/daily_hotwords/schema/words.schema.json",
  "title": "求知每日热词",
  "description": "求知 App 每日远程热词数组",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "word",
      "pinyin",
      "field",
      "difficulty",
      "pack",
      "publishedDate",
      "category",
      "simpleExplanation",
      "lifeAnalogy",
      "practicalApplication",
      "commonMisconception",
      "definition"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "description": "YYYYMMDDNN 格式的唯一整数 ID"
      },
      "word": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      },
      "pinyin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "field": {
        "type": "string",
        "enum": ["通用", "物理", "哲学", "心理学", "工程测量"]
      },
      "difficulty": {
        "type": "string",
        "enum": ["低", "中", "高"]
      },
      "pack": {
        "const": "每日热词"
      },
      "publishedDate": {
        "type": "string",
        "format": "date",
        "description": "发布日期，固定为 YYYY-MM-DD"
      },
      "category": {
        "type": "string",
        "enum": ["科技", "财经", "社会", "科学", "文化", "教育", "健康", "心理", "生活", "其他"]
      },
      "simpleExplanation": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "lifeAnalogy": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "practicalApplication": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "commonMisconception": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "definition": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri",
        "maxLength": 500,
        "description": "热词出处/原文链接，标注信息来源（菜鸟教程词包风格）"
      },
      "appear": {
        "type": "string",
        "maxLength": 300,
        "description": "热词在热点中出现的具体时间（含来源），满足“标明热词出现的时间”要求"
      }
    }
  }
}
